# Copy into the Cloudflare Pages production environment UI; do not commit a real .env.production.
NEXT_PUBLIC_SUPABASE_URL=https://<production-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<production-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<production-service-role-key>
NEXT_PUBLIC_APP_URL=https://snaparcade.id
NEXT_PUBLIC_KIOSK_URL=https://kiosk.snaparcade.id
DATABASE_URL=postgresql://<production-user>:<password>@<production-host>:5432/postgres?sslmode=require
ENCRYPTION_KEY=<output-of-openssl-rand-base64-32>
NOTIFICATION_CRON_SECRET=<long-random-cron-secret>
UPSTASH_REDIS_REST_URL=https://<region>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<production-upstash-token>
XENDIT_WEBHOOK_IPS=<comma-separated-production-ips>
MIDTRANS_WEBHOOK_IPS=<comma-separated-production-ips>
TRIPAY_WEBHOOK_IPS=<comma-separated-production-ips>
SUPABASE_STORAGE_BUCKET_SESSIONS=session-photos
SUPABASE_STORAGE_BUCKET_FRAMES=frames
PAKASIR_PROJECT=<production-project-slug>
PAKASIR_API_KEY=<production-api-key>
PAKASIR_WEBHOOK_SECRET=<production-webhook-secret>
PAKASIR_BASE_URL=https://app.pakasir.com
XENDIT_WEBHOOK_TOKEN=<production-default-callback-token>
KIOSK_PAIRING_PEPPER=<long-random-production-pepper>
KIOSK_TOKEN_TTL_HOURS=720
INVITATION_TOKEN_TTL_DAYS=7
SUPERADMIN_EMAIL=admin@snaparcade.id
