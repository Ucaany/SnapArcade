{
  "name": "snaparcade",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy:worker": "wrangler deploy",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "auth:check": "tsx src/lib/auth-policy.check.ts",
    "payment-crypto:check": "tsx src/lib/payment-crypto.check.ts",
    "payment-verify:check": "tsx src/lib/payment-verify.check.ts",
    "pakasir:check": "tsx src/lib/pakasir.check.ts",
    "tripay:check": "tsx --conditions react-server src/lib/tripay.check.ts",
    "kiosk-auth:check": "tsx --conditions react-server --env-file=.env.local src/lib/kiosk-auth.check.ts",
    "kiosk-session:check": "tsx --conditions react-server --env-file=.env.local src/lib/kiosk-session.check.ts",
    "printer-usb:check": "tsx src/lib/printer-usb.check.ts",
    "voucher:check": "tsx src/lib/voucher.check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts"
  },
  "keywords": [],
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@react-pdf/renderer": "^4.9.0",
