    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "isomorphic-dompurify": "^2.36.0",
    "json2csv": "^6.0.0-alpha.2",
    "lucide-react": "^1.48.0",
    "next": "^15.5.26",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
