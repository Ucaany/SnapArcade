# Supabase project URL and client keys are used by app tasks, not DB migrations.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-placeholder
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Direct PostgreSQL connection string used by Drizzle.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Database workflow: npm run db:generate, npm run db:migrate, npm run db:seed
# Seed profiles use demo UUIDs; matching Auth users must exist before seeding.
