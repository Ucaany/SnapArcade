# Supabase project URL and client keys are used by app tasks, not DB migrations.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-placeholder
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_KIOSK_URL=http://localhost:3000/kiosk

# Direct PostgreSQL connection string used by Drizzle.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Required for encrypted payment gateway credentials; generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
NOTIFICATION_CRON_SECRET=replace-with-cron-secret
UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token
# Comma-separated provider source IPs. Keep empty only for local development.
XENDIT_WEBHOOK_IPS=
MIDTRANS_WEBHOOK_IPS=
TRIPAY_WEBHOOK_IPS=
SUPABASE_STORAGE_BUCKET_SESSIONS=session-photos
PAKASIR_PROJECT=your-pakasir-project-slug
PAKASIR_API_KEY=replace-with-pakasir-api-key
PAKASIR_WEBHOOK_SECRET=replace-with-webhook-secret
# Optional local/mock API base; production defaults to https://app.pakasir.com
PAKASIR_BASE_URL=https://app.pakasir.com

# Production-only values. Never commit real values or .env.production.
# NEXT_PUBLIC_APP_URL=https://snaparcade.id
# NEXT_PUBLIC_KIOSK_URL=https://kiosk.snaparcade.id

# Database workflow: npm run db:generate, npm run db:migrate, npm run db:seed
# Seed profiles use demo UUIDs; matching Auth users must exist before seeding.
